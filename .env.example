# Local dev default (SQLite, zero setup). For production, use a Postgres
# connection string from a managed provider like Supabase or Neon, e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Random secret used to sign auth session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used to build absolute display links/QR codes).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rush/Fleet billing (WooCommerce on a separate WordPress site). Leave unset
# in dev — the Upgrade page shows "billing isn't set up yet" until these are
# filled in. See "Billing (Rush/Fleet plans via WooCommerce)" in the README.
WOOCOMMERCE_SITE_URL=""
WOOCOMMERCE_RUSH_PRODUCT_ID=""
WOOCOMMERCE_FLEET_PRODUCT_ID=""
WOOCOMMERCE_WEBHOOK_SECRET=""
